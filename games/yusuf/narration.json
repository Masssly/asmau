[
  { "id": "scene-1", "text": "Yusuf's brothers felt jealous of him.",                           "lang": "en" },
  { "id": "scene-2", "text": "They took him to a deep well.",                                    "lang": "en" },
  { "id": "scene-3", "text": "They lowered Yusuf into the well. Allah was watching over him.",    "lang": "en" },
  { "id": "scene-4", "text": "A caravan of travellers stopped nearby.",                           "lang": "en" },
  { "id": "scene-5", "text": "Pull the bucket up!",                                               "lang": "en" },
  { "id": "scene-5-found", "text": "You found him!",                                              "lang": "en" },
  { "id": "scene-6", "text": "Good news! Here is a boy!",                                         "lang": "en" },
  { "id": "scene-7", "text": "Allah had a plan all along.",                                       "lang": "en" }
]
